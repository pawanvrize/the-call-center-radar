# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.vite/

# Env / secrets — real API keys live only here, never committed
.env
.env.local
backend/.env

# Data — the dataset (real customer call recordings) and generated DB/audio
# are never committed. 1,441 calls / ~500MB — far too large and sensitive for
# git history; the README documents how to fetch/unzip it locally instead.
callradar-data/
data/audio/*
!data/audio/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
# Split-channel scratch: rebuilt per call, never read again.
data/work/

*.db
*.sqlite3

# ...but DO ship the analysed database and the transcripts. Re-running the
# pipeline costs real money (~$7 of AssemblyAI credit) and ~90 minutes, and the
# brief asks for a system that is "ready to demonstrate" — so anyone cloning
# this gets 1,441 analysed calls immediately and can skip straight to serving.
# Both are small: 16MB each.
!data/radar.db
!data/cache/**
*.db-wal
*.db-shm
# Snapshots taken before a destructive backfill. Local safety nets, not history.
*.backup-*
*.db.bak

# Pipeline working files — split-channel wavs and other transient output
# produced while processing a call (see app/pipeline/audio.py)
**/*.agent.wav
**/*.customer.wav
backend/work/
backend/smoketest.wav

# OS / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Planning/scratch docs — pre-build brainstorms, not part of the shipped
# system (their useful ideas already made it into RADAR_PLAYBOOK.md /
# README.md, or were deliberately rejected). Kept locally, not in the repo.
differentiator.md
implementation.md
LANGGRAPH_REASONING.md
