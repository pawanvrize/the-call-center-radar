# --- Transcription provider ---
# assemblyai (primary, multichannel, spends the free credit) | whisper (offline)
TRANSCRIBER_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=

# faster-whisper settings, used when TRANSCRIBER_PROVIDER=whisper.
# tiny.en for smoke tests, small.en for the real offline run.
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Reasoning layer (intent / resolution / summary) ---
# groq (primary, default below) | bedrock | azure | ollama (offline fallback)
#
# Whichever you pick, it MUST enforce a JSON schema. The citation design works
# because the model can only return a turn NUMBER — never a quote — so the
# schema is what makes fabricated citations structurally impossible. A provider
# that only offers "valid JSON" without schema adherence breaks that guarantee.
LLM_PROVIDER=groq

# Claude on AWS Bedrock. Structured outputs are GA here, and there's no
# equivalent of Groq's 8000-tokens/minute free-tier ceiling (which caps the
# full 1,441-call run at ~9 calls/min, i.e. ~2.7 hours).
# Leave the keys blank to use the ambient AWS credential chain instead.
# Requires model access enabled for this model in the Bedrock console.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL=openai.gpt-oss-120b-1:0

# Groq. Note: only the gpt-oss models support strict json_schema — every other
# Groq model degrades to json_object (valid JSON, no schema adherence).
# --- Azure OpenAI ---
# DEPLOYMENT is the name you gave the deployment in Azure AI Foundry, which is
# often NOT the model name. Endpoint has no trailing path, e.g.
#   https://my-resource.openai.azure.com
# api-version must be recent enough to support json_schema structured outputs;
# older versions accept the field and silently downgrade to unvalidated JSON.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# --- Storage ---
DATABASE_PATH=./data/radar.db
DATA_DIR=./data

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Evidence verification ---
EVIDENCE_MATCH_THRESHOLD=85
EVIDENCE_MIN_QUOTE_WORDS=5
